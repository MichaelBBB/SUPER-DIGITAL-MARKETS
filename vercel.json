{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/home" }
  ],
  "headers": [
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/home", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/payment", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/live-trackers", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
